@model dreams.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Вход";
    Layout = "_AuthLayout";
}

<div class="main-wrapper">
    <div class="login-content">
        <div class="row">

            <div class="col-lg-6 login-bg d-none d-lg-flex">
                <div class="login-carousel">
                    <div>
                        <div class="login-carousel-section mb-3">
                            <div class="login-banner">
                                <img src="~/assets/img/auth/auth-1.svg" class="img-fluid" alt="EduPlatform">
                            </div>
                            <div class="mentor-course text-center">
                                <h3 class="mb-2">Добро пожаловать в <br>Edu<span class="text-secondary">Platform</span></h3>
                                <p>Платформа для размещения и прохождения онлайн-курсов. Учитесь у лучших инструкторов и стройте свой курс с нуля.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 login-wrap-bg">
                <div class="login-wrapper">
                    <div class="loginbox">
                        <div class="w-100">
                            <div class="d-flex align-items-center justify-content-between login-header">
                                <img src="~/assets/img/logo.svg" class="img-fluid" alt="EduPlatform">
                                <a href="/" class="link-1">На главную</a>
                            </div>
                            <h1 class="fs-32 fw-bold topic">Вход в аккаунт</h1>
                            <form method="post" asp-action="Login" class="mb-3 pb-3">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                @if ((bool?)ViewData["NeedsConfirmation"] == true)
                                {
                                    var unconfirmed = ViewData["UnconfirmedEmail"] as string;
                                    <div class="alert alert-warning fs-14">
                                        Email <strong>@unconfirmed</strong> не подтверждён.
                                        <a href="/account/confirm-email-sent?email=@unconfirmed" class="link-secondary">Открыть страницу подтверждения</a>.
                                    </div>
                                }
                                <div class="mb-3 position-relative">
                                    <label asp-for="Email" class="form-label">Email<span class="text-danger ms-1">*</span></label>
                                    <div class="position-relative">
                                        <input asp-for="Email" type="email" class="form-control form-control-lg">
                                        <span><i class="isax isax-sms input-icon text-gray-7 fs-14"></i></span>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="mb-3 position-relative">
                                    <label asp-for="Password" class="form-label">Пароль<span class="text-danger ms-1">*</span></label>
                                    <div class="position-relative" id="passwordInput">
                                        <input asp-for="Password" type="password" class="pass-inputs form-control form-control-lg">
                                        <span class="isax toggle-passwords isax-eye-slash fs-14"></span>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="remember-me d-flex align-items-center">
                                        <input asp-for="RememberMe" class="form-check-input" type="checkbox">
                                        <label asp-for="RememberMe" class="form-check-label ms-2">Запомнить меня</label>
                                    </div>
                                    <a href="/account/forgot" class="link-2">Забыли пароль?</a>
                                </div>
                                <div class="d-grid">
                                    <button class="btn btn-secondary btn-lg" type="submit">Войти <i class="isax isax-arrow-right-3 ms-1"></i></button>
                                </div>
                            </form>

                            <div class="fs-14 fw-normal d-flex align-items-center justify-content-center">
                                Нет аккаунта?<a href="/account/register" class="link-2 ms-1">Зарегистрироваться</a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
