@model dreams.Models.Courses.CourseDetailsViewModel
@{
    var c = Model.Course;
    ViewData["Title"] = c.Title;
    Layout = "_InnerLayout";

    string PriceLabel(decimal p) => p == 0 ? L["Common.Free"].Value : $"{p:N0} ₽";
    var toast = TempData["Toast"] as string;
}

<div class="breadcrumb-bar text-center">
    <div class="container">
        <h2 class="breadcrumb-title mb-2">@c.Title</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/">Главная</a></li>
                <li class="breadcrumb-item"><a href="/courses">Курсы</a></li>
                <li class="breadcrumb-item active" aria-current="page">@c.Title</li>
            </ol>
        </nav>
    </div>
</div>

<section class="course-details-two">
    <div class="container">
        @if (!string.IsNullOrEmpty(toast))
        {
            <div class="alert alert-info">@toast</div>
        }
        @if (!c.IsPublished)
        {
            <div class="alert alert-warning">@L["Course.NotPublishedOwner"]</div>
        }

        <div class="row">
            <div class="col-12">
                <div class="card bg-light">
                    <div class="card-body d-lg-flex align-items-center">
                        <img class="img-fluid rounded-2" src="@c.CoverUrl" alt="@c.Title" style="max-width: 320px;">
                        <div class="w-100 ps-lg-4 mt-3 mt-lg-0">
                            <span class="badge badge-sm rounded-pill bg-warning fs-12 mb-2">@c.Category.Name</span>
                            <h3 class="mb-2">@c.Title</h3>
                            <p class="fs-14 mb-3">@c.Description</p>
                            <div class="d-flex align-items-center gap-3 flex-wrap mb-3">
                                <span class="d-flex align-items-center"><i class="isax isax-book me-2"></i>@Model.LessonsCount @L["Course.Lessons"]</span>
                                <span class="d-flex align-items-center"><i class="isax isax-people me-2"></i>@c.StudentsCount @L["Course.Students"]</span>
                                <span class="d-flex align-items-center"><i class="fa-solid fa-star text-warning me-2"></i>@c.AverageRating.ToString("0.0")</span>
                                <span class="d-flex align-items-center"><i class="isax isax-global me-2"></i>@(c.Language == "ru" ? "Русский" : "English")</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="avatar avatar-md">
                                    <img class="rounded-circle" src="@(string.IsNullOrEmpty(c.Instructor.AvatarUrl) ? "/assets/img/user/user-29.jpg" : c.Instructor.AvatarUrl)" alt="">
                                </span>
                                <div class="ms-2">
                                    <a href="/instructors/@c.InstructorId" class="fw-semibold link-default">@c.Instructor.FullName</a>
                                    <div class="fs-13 text-muted">@L["Course.Instructor"]</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="mb-3">Описание курса</h5>
                        <p class="mb-0">@c.Description</p>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between flex-wrap">
                            <h5 class="subs-title mb-3">@L["Course.Program"]</h5>
                            <h6 class="fs-16 fw-medium text-gray-7 mb-3">
                                @c.Sections.Count модулей · @Model.LessonsCount уроков
                            </h6>
                        </div>

                        @if (c.Sections.Count == 0)
                        {
                            <p class="text-muted mb-0">Программа курса пока не добавлена.</p>
                        }
                        else
                        {
                            <div class="accordion accordion-customicon1 accordions-items-seperate p-0" id="programAccordion">
                                @foreach (var sec in c.Sections.OrderBy(s => s.OrderIndex))
                                {
                                    var sId = "sec-" + sec.Id.ToString("N");
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed" type="button"
                                                    data-bs-toggle="collapse" data-bs-target="#@sId">
                                                @sec.Title <i class="fa-solid fa-chevron-down"></i>
                                            </button>
                                        </h2>
                                        <div id="@sId" class="accordion-collapse collapse" data-bs-parent="#programAccordion">
                                            <div class="accordion-body p-0">
                                                <ul class="list-unstyled mb-0">
                                                    @foreach (var lesson in sec.Lessons.OrderBy(l => l.OrderIndex))
                                                    {
                                                        <li class="p-3 d-flex justify-content-between align-items-center border-bottom">
                                                            <span><i class="isax isax-play-circle me-2 text-secondary"></i>@lesson.Title</span>
                                                            @if (Model.IsEnrolled)
                                                            {
                                                                <a href="/student/courses/@c.Slug/lessons/@lesson.Id" class="link-secondary fs-14">Перейти</a>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* ---------- ОТЗЫВЫ ---------- *@
                <div class="card mb-4" id="reviews">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Отзывы</h5>
                            <div class="text-muted small">@Model.ReviewsCount отзыв(ов) · средняя @c.AverageRating.ToString("0.0")★</div>
                        </div>

                        @if (Model.ReviewsCount > 0)
                        {
                            <div class="row align-items-center mb-3">
                                <div class="col-md-4 text-center">
                                    <div class="display-5 fw-bold text-secondary">@c.AverageRating.ToString("0.0")</div>
                                    <div class="text-warning fs-5">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            var filled = i <= Math.Round(c.AverageRating);
                                            <i class="fa-solid fa-star @(filled ? "text-warning" : "text-muted opacity-25")"></i>
                                        }
                                    </div>
                                    <div class="text-muted small mt-1">@Model.ReviewsCount оценок</div>
                                </div>
                                <div class="col-md-8">
                                    @for (int stars = 5; stars >= 1; stars--)
                                    {
                                        var cnt = Model.RatingHistogram[5 - stars];
                                        var pct = Model.ReviewsCount == 0 ? 0 : (int)Math.Round(cnt * 100.0 / Model.ReviewsCount);
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="text-muted small" style="width: 30px;">@stars★</span>
                                            <div class="progress flex-grow-1" style="height: 8px;">
                                                <div class="progress-bar bg-warning" style="width:@(pct)%"></div>
                                            </div>
                                            <span class="text-muted small" style="width: 30px;">@cnt</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.CanLeaveReview)
                        {
                            <div class="border-top pt-3">
                                <h6 class="mb-2">Оставить отзыв</h6>
                                <form method="post" action="/courses/@c.Slug/review">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-2 d-flex gap-1 fs-4 review-stars" id="ratingPick">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <button type="button" class="btn p-0 border-0 star-btn" data-rate="@i" aria-label="@i star">
                                                <i class="fa-regular fa-star text-warning"></i>
                                            </button>
                                        }
                                    </div>
                                    <input type="hidden" name="rating" id="ratingInput" value="" required />
                                    <textarea name="text" class="form-control mb-2" rows="3" maxlength="2000" placeholder="Расскажите, как вам курс (необязательно)"></textarea>
                                    <button type="submit" class="btn btn-primary" id="reviewSubmit" disabled>Отправить отзыв</button>
                                </form>
                            </div>
                        }
                        else if (Model.MyReview is not null)
                        {
                            <div class="alert alert-info d-flex justify-content-between align-items-center">
                                <div>
                                    Ваш отзыв: <b>@Model.MyReview.Rating★</b>
                                    @if (!Model.MyReview.IsApproved) { <span class="badge text-bg-warning ms-1">на модерации</span> }
                                </div>
                                <form method="post" action="/courses/@c.Slug/review/delete" class="m-0"
                                      onsubmit="return confirm('Удалить ваш отзыв?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                </form>
                            </div>
                        }
                        else if (!User.Identity!.IsAuthenticated)
                        {
                            <p class="text-muted small mb-0">Войдите и запишитесь на курс, чтобы оставить отзыв.</p>
                        }
                        else if (!Model.IsEnrolled && !Model.IsOwner)
                        {
                            <p class="text-muted small mb-0">Отзыв можно оставить, только если вы записаны на курс.</p>
                        }

                        @if (Model.Reviews.Count == 0)
                        {
                            <p class="text-muted text-center py-3 mb-0">Пока никто не оставил отзыв. Будьте первым!</p>
                        }
                        else
                        {
                            <div class="border-top pt-3 mt-3">
                                @foreach (var r in Model.Reviews)
                                {
                                    <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                                        <div class="avatar avatar-md flex-shrink-0">
                                            <img class="rounded-circle"
                                                 src="@(string.IsNullOrEmpty(r.Student.AvatarUrl) ? "/assets/img/user/user-29.jpg" : r.Student.AvatarUrl)"
                                                 alt="">
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="fw-semibold">@r.Student.FullName</span>
                                                    @if (!r.IsApproved) { <span class="badge text-bg-warning ms-2">на модерации</span> }
                                                </div>
                                                <small class="text-muted">@r.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                                            </div>
                                            <div class="text-warning small mb-1">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fa-solid fa-star @(i <= r.Rating ? "" : "text-muted opacity-25")"></i>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(r.Text))
                                            {
                                                <p class="mb-0">@r.Text</p>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="course-sidebar-sec mt-0">
                    <div class="card mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h2 class="@(c.Price == 0 ? "text-success" : "text-secondary") fs-30 mb-0">@PriceLabel(c.Price)</h2>
                            </div>

                            @if (Model.IsOwner)
                            {
                                <a href="/instructor/courses/@c.Id/edit" class="btn btn-primary w-100">@L["Course.EditCourse"]</a>
                                <a href="/courses/@c.Slug/chat" class="btn btn-outline-primary w-100 mt-2">
                                    <i class="isax isax-message me-1"></i>@L["Course.ChatLink"]
                                </a>
                            }
                            else if (Model.IsEnrolled)
                            {
                                <a href="/student/courses/@c.Slug" class="btn btn-primary w-100">@L["Course.GoToLearning"]</a>
                                <a href="/courses/@c.Slug/chat" class="btn btn-outline-primary w-100 mt-2">
                                    <i class="isax isax-message me-1"></i>@L["Course.ChatLink"]
                                </a>
                            }
                            else if (User?.Identity?.IsAuthenticated == true)
                            {
                                <form method="post" action="/courses/@c.Slug/enroll" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary w-100">@L["Course.Enroll"]</button>
                                </form>
                            }
                            else
                            {
                                <a href="/account/login?returnUrl=/courses/@c.Slug" class="btn btn-primary w-100">@L["Course.LoginToEnroll"]</a>
                            }
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body">
                            <h5 class="subs-title mb-3">@L["Course.IncludedTitle"]</h5>
                            <p class="mb-2"><i class="isax isax-play-circle me-2 text-secondary"></i>@Model.LessonsCount @L["Course.IncludedVideo"]</p>
                            <p class="mb-2"><i class="isax isax-document me-2 text-secondary"></i>@L["Course.IncludedText"]</p>
                            <p class="mb-2"><i class="isax isax-clock me-2 text-secondary"></i>@L["Course.IncludedForever"]</p>
                            <p class="mb-0"><i class="isax isax-medal me-2 text-secondary"></i>Сертификат при завершении</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const pick = document.getElementById('ratingPick');
            if (!pick) return;
            const input = document.getElementById('ratingInput');
            const submit = document.getElementById('reviewSubmit');
            const stars = pick.querySelectorAll('.star-btn');
            function paint(n) {
                stars.forEach((b, i) => {
                    const ic = b.querySelector('i');
                    if (i < n) { ic.classList.remove('fa-regular'); ic.classList.add('fa-solid'); }
                    else { ic.classList.remove('fa-solid'); ic.classList.add('fa-regular'); }
                });
            }
            stars.forEach(b => {
                b.addEventListener('mouseenter', () => paint(+b.dataset.rate));
                b.addEventListener('click', () => {
                    input.value = b.dataset.rate;
                    submit.disabled = false;
                    paint(+b.dataset.rate);
                });
            });
            pick.addEventListener('mouseleave', () => paint(+(input.value || 0)));
        })();
    </script>
}
