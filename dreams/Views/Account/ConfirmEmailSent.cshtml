@{
    ViewData["Title"] = L["Auth.ConfirmSent"].Value;
    Layout = "_AuthLayout";
    var email = ViewData["Email"] as string;
    var toast = TempData["Toast"] as string;
}

<div class="main-wrapper">
    <div class="login-content">
        <div class="row">
            <div class="col-lg-6 login-bg d-none d-lg-flex">
                <div class="login-carousel">
                    <div class="login-carousel-section">
                        <div class="login-banner">
                            <img src="~/assets/img/auth/auth-1.svg" class="img-fluid" alt="EduPlatform">
                        </div>
                        <div class="mentor-course text-center">
                            <h3 class="mb-2">Почти готово!</h3>
                            <p>Проверьте почту и подтвердите email, чтобы войти в EduPlatform.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 login-wrap-bg">
                <div class="login-wrapper">
                    <div class="loginbox">
                        <div class="w-100">
                            <div class="d-flex align-items-center justify-content-between login-header">
                                <img src="~/assets/img/logo.svg" class="img-fluid" alt="EduPlatform">
                                <a href="/" class="link-1">@L["Nav.Home"]</a>
                            </div>
                            <h1 class="fs-32 fw-bold topic">@L["Auth.ConfirmSent"]</h1>
                            <p class="mb-3">
                                @L["Auth.ConfirmSentText"] <strong>@email</strong>
                            </p>
                            <div class="alert alert-info fs-14">
                                Локальная разработка: письма складываются в <code>App_Data/mail/</code> как .eml-файлы.
                            </div>
                            @if (!string.IsNullOrEmpty(toast))
                            {
                                <div class="alert alert-success">@toast</div>
                            }

                            <form method="post" action="/account/resend-confirmation" class="mb-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="email" value="@email" />
                                <button type="submit" class="btn btn-outline-secondary">Отправить письмо ещё раз</button>
                            </form>

                            <div class="fs-14">
                                <a href="/account/login" class="link-2">@L["Auth.GoToLogin"]</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
