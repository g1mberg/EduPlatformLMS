@{
    ViewData["Title"] = "Восстановление пароля";
    Layout = "_AuthLayout";
    var sent = (bool)(ViewData["Sent"] ?? false);
    var email = ViewData["Email"] as string;
    var toast = ViewData["Toast"] as string;
}

<div class="main-wrapper">
    <div class="login-content">
        <div class="row">
            <div class="col-lg-6 login-bg d-none d-lg-flex">
                <div class="login-carousel">
                    <div class="login-carousel-section">
                        <div class="login-banner">
                            <img src="~/assets/img/auth/auth-1.svg" class="img-fluid" alt="EduPlatform">
                        </div>
                        <div class="mentor-course text-center">
                            <h3 class="mb-2">Забыли пароль?</h3>
                            <p>Не страшно. Введите email — мы вышлем ссылку для сброса.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 login-wrap-bg">
                <div class="login-wrapper">
                    <div class="loginbox">
                        <div class="w-100">
                            <div class="d-flex align-items-center justify-content-between login-header">
                                <img src="~/assets/img/logo.svg" class="img-fluid" alt="EduPlatform">
                                <a href="/" class="link-1">На главную</a>
                            </div>
                            <h1 class="fs-32 fw-bold topic">Восстановление пароля</h1>

                            @if (sent)
                            {
                                <div class="alert alert-success">
                                    Если аккаунт с email <b>@email</b> существует и подтверждён,
                                    мы только что отправили на него письмо со ссылкой для сброса.
                                </div>
                                <a href="/account/login" class="btn btn-secondary w-100">Назад ко входу</a>
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(toast))
                                {
                                    <div class="alert alert-warning fs-14">@toast</div>
                                }
                                <form method="post" action="/account/forgot" class="mb-3 pb-3">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3 position-relative">
                                        <label class="form-label">Email<span class="text-danger ms-1">*</span></label>
                                        <input type="email" name="email" class="form-control form-control-lg" required>
                                    </div>
                                    <div class="d-grid">
                                        <button class="btn btn-secondary btn-lg" type="submit">
                                            Отправить ссылку <i class="isax isax-arrow-right-3 ms-1"></i>
                                        </button>
                                    </div>
                                </form>
                                <div class="fs-14 text-center">
                                    <a href="/account/login" class="link-2">Назад ко входу</a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
