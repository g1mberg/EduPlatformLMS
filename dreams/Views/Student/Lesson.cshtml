@model dreams.Models.Courses.StudentLessonViewModel
@{
    var c = Model.Course;
    var l = Model.Lesson;
    ViewData["Title"] = l.Title;
    ViewData["DashboardArea"] = "student";
    Layout = "_DashboardLayout";
}

<div class="breadcrumb-bar text-center">
    <div class="container">
        <h2 class="breadcrumb-title mb-2">@l.Title</h2>
        <nav>
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/student/courses">Мои курсы</a></li>
                <li class="breadcrumb-item"><a href="/student/courses/@c.Slug">@c.Title</a></li>
                <li class="breadcrumb-item active">@l.Title</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                @if (!string.IsNullOrEmpty(l.VideoUrl))
                {
                    <div class="ratio ratio-16x9 mb-4 rounded overflow-hidden shadow-sm">
                        <iframe src="@l.VideoUrl" title="@l.Title" allowfullscreen></iframe>
                    </div>
                }

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h5 class="mb-3">@l.Title</h5>
                        <p class="text-muted fs-14 mb-3">Модуль: @Model.Section.Title</p>
                        <div>@l.TextContent</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        @if (Model.PrevLessonId.HasValue)
                        {
                            <a href="/student/courses/@c.Slug/lessons/@Model.PrevLessonId" class="btn btn-outline-secondary">
                                <i class="isax isax-arrow-left-2 me-1"></i>Предыдущий урок
                            </a>
                        }
                    </div>

                    @if (l.Test is not null)
                    {
                        <a href="/student/courses/@c.Slug/lessons/@l.Id/test" class="btn btn-success">
                            <i class="isax isax-task me-1"></i>
                            @(Model.IsCompleted ? "Пересдать тест" : "Пройти тест")
                        </a>
                    }
                    else
                    {
                        <form method="post" action="/student/courses/@c.Slug/lessons/@l.Id/complete" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn @(Model.IsCompleted ? "btn-outline-success" : "btn-success")">
                                @if (Model.IsCompleted)
                                {
                                    <i class="isax isax-tick-circle me-1"></i>
                                    <text>Пройдено · отменить</text>
                                }
                                else
                                {
                                    <i class="isax isax-tick-square me-1"></i>
                                    <text>Отметить пройденным</text>
                                }
                            </button>
                        </form>
                    }

                    <div>
                        @if (Model.NextLessonId.HasValue)
                        {
                            <a href="/student/courses/@c.Slug/lessons/@Model.NextLessonId" class="btn btn-secondary">
                                Следующий урок <i class="isax isax-arrow-right-3 ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="mb-3">Прогресс курса</h6>
                        <div class="progress mb-2" style="height: 8px;">
                            <div class="progress-bar bg-secondary"
                                 style="width: @Model.ProgressPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                        <p class="mb-3 fs-14 text-muted">@Model.ProgressPercent.ToString("0.#")% завершено</p>
                        <a href="/student/courses/@c.Slug" class="btn btn-outline-secondary w-100">К программе курса</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
