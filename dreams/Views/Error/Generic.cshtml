@model int
@{
    ViewData["Title"] = $"Ошибка {Model}";
    Layout = "_InnerLayout";
}

<section class="py-5">
    <div class="container text-center" style="padding: 60px 0;">
        <div style="font-size: 120px; line-height: 1; font-weight: 800; color: #6b7280;">@Model</div>
        <h2 class="mt-3 mb-2">Что-то пошло не так</h2>
        <p class="text-muted mb-4">Произошла ошибка @Model. Попробуйте позже или вернитесь на главную.</p>
        <a href="/" class="btn btn-primary"><i class="isax isax-home me-1"></i>На главную</a>
    </div>
</section>
