@model dreams.Models.Courses.SubscriptionPageViewModel
@using dreams.Models.Entities
@{
    ViewData["Title"] = L["Sub.Title"].Value;
    Layout = "_InnerLayout";

    var toast = TempData["Toast"] as string;
    var plansByCode = Model.Plans.ToDictionary(p => p.Code);
    var free  = plansByCode.GetValueOrDefault(SubscriptionPlanCode.Free);
    var basic = plansByCode.GetValueOrDefault(SubscriptionPlanCode.Basic);
    var pro   = plansByCode.GetValueOrDefault(SubscriptionPlanCode.Pro);
}

@section Styles {
    <style>
        .pricing-cover .pricing-item { position: relative; }
        .pricing-cover .badge-recommend {
            position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
            padding: 6px 16px; border-radius: 999px;
            background: var(--primary); color: #fff; font-weight: 600; font-size: 12px;
            white-space: nowrap;
        }
        .balance-pill {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 8px 16px; border-radius: 999px;
            background: rgba(77,68,224,.08); color: #4d44e0; font-weight: 600;
        }
    </style>
}

@{
    async Task RenderBuyButton(SubscriptionPlan? p, string btnClass, string ctaLabel)
    {
        if (p is null) { return; }
        if (!Model.IsAuthenticated)
        {
            <a href="/account/login?returnUrl=/instructor/subscription" class="btn @btnClass w-100">@L["Sub.LoginToBuy"]</a>
            return;
        }
        if (Model.ActivePlanCode == p.Code)
        {
            <button class="btn btn-outline-success w-100" disabled>
                <i class="isax isax-tick-circle me-1"></i>@L["Sub.CurrentPlan"]
            </button>
            return;
        }
        var enough = Model.Credits >= p.PriceCredits;
        <form method="post" action="/instructor/subscription/buy/@p.Id" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn @btnClass w-100" @(enough ? "" : "disabled")>
                @if (enough) { @ctaLabel } else { @L["Sub.NotEnough", (p.PriceCredits - Model.Credits).ToString("N0")] }
            </button>
        </form>
        await Task.CompletedTask;
    }
}

<div class="breadcrumb-bar text-center">
    <div class="container">
        <h2 class="breadcrumb-title mb-2">@L["Sub.Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/">@L["Nav.Home"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@L["Nav.Subscriptions"]</li>
            </ol>
        </nav>
    </div>
</div>

<section class="pricing-plan-sec">
    <div class="container">

        @if (!string.IsNullOrEmpty(toast))
        {
            <div class="alert alert-info text-center">@toast</div>
        }

        <div class="row">
            <div class="col-lg-8 mx-auto text-center mb-4">
                <p class="fw-medium text-secondary mb-2">@L["Sub.Eyebrow"]</p>
                <h2 class="main-title mb-2">@L["Sub.Heading"]</h2>
                <p>@L["Sub.Subheading"]</p>

                @if (Model.IsAuthenticated)
                {
                    <div class="mt-3">
                        <span class="balance-pill">
                            <i class="isax isax-wallet-3"></i>
                            @L["Sub.Balance"]: @Model.Credits.ToString("N0") @L["Sub.Credits"]
                        </span>
                        @if (Model.ActivePlanCode is not null)
                        {
                            <span class="ms-2 badge text-bg-success">
                                @L["Sub.Active"]: @Model.ActivePlanCode
                                @if (Model.ActiveExpiresAt.HasValue) { @($" — {Model.ActiveExpiresAt.Value.ToLocalTime():dd.MM.yyyy}") }
                            </span>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="row pricing-cover justify-content-center">

            <div class="col-xl-4 col-md-6 px-2 d-flex">
                <div class="pricing-item flex-fill @(Model.ActivePlanCode == SubscriptionPlanCode.Free ? "border border-success" : "")">
                    <h5 class="mb-2">Free</h5>
                    <h1 class="mb-2">@L["Common.Free"]</h1>
                    <p>@L["Sub.PlanFreeDesc"]</p>
                    <div class="border-top pt-3 mt-3">
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.MaxCoursesUpTo", free?.MaxCourses ?? 3]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.Commission", free?.CommissionPercent ?? 30m]</p>
                        <p class="d-flex align-items-center mb-3 text-muted"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.NoTests"]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.AnalyticsBasic"]</p>
                        @{ await RenderBuyButton(free, "btn-start-free", L["Sub.StartFree"].Value); }
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-6 px-2 d-flex">
                <div class="pricing-item flex-fill @(Model.ActivePlanCode == SubscriptionPlanCode.Basic ? "border border-success" : "border border-primary")">
                    @if (Model.ActivePlanCode != SubscriptionPlanCode.Basic)
                    {
                        <span class="badge-recommend">@L["Sub.Recommend"]</span>
                    }
                    <h5 class="mb-2">Basic</h5>
                    <h1 class="mb-2">@(basic?.PriceCredits ?? 100) <sup class="fs-24 ms-1">@L["Sub.Credits"]</sup></h1>
                    <p>@L["Sub.PlanBasicDesc"]</p>
                    <div class="border-top pt-3 mt-3">
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.MaxCoursesUpTo", basic?.MaxCourses ?? 10]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.Commission", basic?.CommissionPercent ?? 20m]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.WithTests"]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.WithCerts"]</p>
                        @{ await RenderBuyButton(basic, "btn-primary", L["Sub.BuyFor", (basic?.PriceCredits ?? 100).ToString("N0")].Value); }
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-md-6 px-2 d-flex">
                <div class="pricing-item flex-fill @(Model.ActivePlanCode == SubscriptionPlanCode.Pro ? "border border-success" : "")">
                    <h5 class="mb-2">Pro</h5>
                    <h1 class="mb-2">@(pro?.PriceCredits ?? 300) <sup class="fs-24 ms-1">@L["Sub.Credits"]</sup></h1>
                    <p>@L["Sub.PlanProDesc"]</p>
                    <div class="border-top pt-3 mt-3">
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.MaxCoursesUnlim"]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.Commission", pro?.CommissionPercent ?? 10m]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.AllBasicFeatures"]</p>
                        <p class="d-flex align-items-center mb-3"><i class="fa-solid fa-circle fs-5 me-2"></i>@L["Sub.AnalyticsAdvanced"]</p>
                        @{ await RenderBuyButton(pro, "btn-start-free", L["Sub.BuyFor", (pro?.PriceCredits ?? 300).ToString("N0")].Value); }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
