@model dreams.Models.Courses.TestResultViewModel
@{
    var c = Model.Course;
    var a = Model.Attempt;
    ViewData["Title"] = "Результат теста";
    ViewData["DashboardArea"] = "student";
    Layout = "_DashboardLayout";
}

<div class="breadcrumb-bar text-center">
    <div class="container">
        <h2 class="breadcrumb-title mb-2">Результат теста</h2>
        <nav>
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/student/courses">Мои курсы</a></li>
                <li class="breadcrumb-item"><a href="/student/courses/@c.Slug">@c.Title</a></li>
                <li class="breadcrumb-item active">Результат</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card border-0 shadow-sm text-center mb-4">
                    <div class="card-body p-5">
                        @if (a.IsPassed)
                        {
                            <i class="isax isax-tick-circle text-success" style="font-size: 64px;"></i>
                            <h3 class="mt-3">Тест сдан!</h3>
                        }
                        else
                        {
                            <i class="isax isax-close-circle text-danger" style="font-size: 64px;"></i>
                            <h3 class="mt-3">Тест не сдан</h3>
                        }
                        <p class="display-5 fw-bold @(a.IsPassed ? "text-success" : "text-danger") my-3">@a.Score%</p>
                        <p class="text-muted mb-4">Проходной балл — @Model.Test.PassingScore%.</p>

                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <a href="/student/courses/@c.Slug/lessons/@Model.Lesson.Id/test" class="btn btn-outline-secondary">
                                Пройти ещё раз
                            </a>
                            <a href="/student/courses/@c.Slug" class="btn btn-secondary">К программе курса</a>
                        </div>
                    </div>
                </div>

                @if (Model.Certificate is not null)
                {
                    <div class="card border-success shadow-sm">
                        <div class="card-body p-4 text-center">
                            <i class="isax isax-medal text-warning" style="font-size: 48px;"></i>
                            <h5 class="mt-2">Поздравляем! Вы получили сертификат</h5>
                            <p class="text-muted mb-3">Номер: <code>@Model.Certificate.CertificateNumber</code></p>
                            <a href="/student/certificates/@Model.Certificate.Id" class="btn btn-secondary">Открыть сертификат</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
