@model IReadOnlyList<dreams.Controllers.CategoryRow>
@{
    ViewData["Title"] = "Категории";
    ViewData["PageTitle"] = "Категории курсов";
    ViewData["AdminSection"] = "categories";
    Layout = "_AdminLayout";
}

<div class="row g-3">
    <div class="col-lg-4">
        <div class="adm-card">
            <div class="adm-card-head"><h5>Добавить категорию</h5></div>
            <div class="adm-card-body">
                <form method="post" action="/admin/categories/create">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Название</label>
                        <input name="name" class="form-control" placeholder="Например, Робототехника" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Slug (опционально)</label>
                        <input name="slug" class="form-control" placeholder="robototechnika">
                        <div class="form-text">Если пусто, сгенерируется из названия.</div>
                    </div>
                    <button class="btn btn-adm-primary w-100">Создать</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="adm-card">
            <table class="adm-table">
                <thead>
                    <tr><th>Название</th><th>Slug</th><th class="text-center">Курсов</th><th class="text-end">Действия</th></tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <form method="post" action="/admin/categories/@c.Id/edit" class="d-flex gap-2 m-0 align-items-center">
                                @Html.AntiForgeryToken()
                                <input name="name" value="@c.Name" class="form-control form-control-sm" required>
                                <input name="slug" value="@c.Slug" class="form-control form-control-sm" style="max-width:160px;" required>
                                <button class="btn btn-adm-soft-primary btn-sm" title="Сохранить"><i class="ti ti-check"></i></button>
                            </form>
                        </td>
                        <td></td>
                        <td class="text-center"><span class="adm-badge b-muted">@c.CourseCount</span></td>
                        <td class="text-end">
                            <form method="post" action="/admin/categories/@c.Id/delete" class="m-0"
                                  onsubmit="return confirm('Удалить категорию «@c.Name»?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-adm-soft-danger btn-sm" title="Удалить" @(c.CourseCount > 0 ? "disabled" : "")>
                                    <i class="ti ti-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Категорий нет</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
