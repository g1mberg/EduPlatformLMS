@model dreams.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = L["Auth.RegisterTitle"].Value;
    Layout = "_AuthLayout";
}

<div class="main-wrapper">
    <div class="login-content">
        <div class="row">

            <div class="col-lg-6 login-bg d-none d-lg-flex">
                <div class="login-carousel">
                    <div>
                        <div class="login-carousel-section mb-3">
                            <div class="login-banner">
                                <img src="~/assets/img/auth/auth-1.svg" class="img-fluid" alt="EduPlatform">
                            </div>
                            <div class="mentor-course text-center">
                                <h3 class="mb-2">Присоединяйтесь к <br>Edu<span class="text-secondary">Platform</span></h3>
                                <p>Создайте аккаунт за минуту: подтвердите email и начните учиться или создавать собственные курсы.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 login-wrap-bg">
                <div class="login-wrapper">
                    <div class="loginbox">
                        <div class="w-100">
                            <div class="d-flex align-items-center justify-content-between login-header">
                                <img src="~/assets/img/logo.svg" class="img-fluid" alt="EduPlatform">
                                <a href="/" class="link-1">@L["Nav.Home"]</a>
                            </div>
                            <h1 class="fs-32 fw-bold topic">@L["Auth.RegisterTitle"]</h1>
                            <form method="post" asp-action="Register" class="mb-3 pb-3">
                                @Html.AntiForgeryToken()
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                <div class="mb-3 position-relative">
                                    <label asp-for="FullName" class="form-label">@L["Auth.FullName"]<span class="text-danger ms-1">*</span></label>
                                    <div class="position-relative">
                                        <input asp-for="FullName" type="text" class="form-control form-control-lg">
                                        <span><i class="isax isax-user input-icon text-gray-7 fs-14"></i></span>
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="mb-3 position-relative">
                                    <label asp-for="Email" class="form-label">@L["Auth.Email"]<span class="text-danger ms-1">*</span></label>
                                    <div class="position-relative">
                                        <input asp-for="Email" type="email" class="form-control form-control-lg">
                                        <span><i class="isax isax-sms input-icon text-gray-7 fs-14"></i></span>
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                </div>
                                <div class="mb-3 position-relative">
                                    <label asp-for="Password" class="form-label">@L["Auth.Password"]<span class="text-danger"> *</span></label>
                                    <div class="position-relative" id="passwordInput">
                                        <input asp-for="Password" type="password" class="pass-inputs form-control form-control-lg">
                                        <span class="isax toggle-passwords isax-eye-slash text-gray-7 fs-14"></span>
                                    </div>
                                    <div class="form-text">Минимум 8 символов.</div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>
                                <div class="mb-3 position-relative">
                                    <label asp-for="ConfirmPassword" class="form-label">@L["Auth.ConfirmPassword"]<span class="text-danger"> *</span></label>
                                    <div class="position-relative">
                                        <input asp-for="ConfirmPassword" type="password" class="pass-inputa form-control form-control-lg">
                                        <span class="isax toggle-passworda isax-eye-slash text-gray-7 fs-14"></span>
                                    </div>
                                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                                </div>
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="remember-me d-flex align-items-center">
                                        <input class="form-check-input" type="checkbox" required id="agree">
                                        <label class="form-check-label mb-0 d-inline-flex fs-14 ms-2" for="agree">
                                            Я принимаю <a href="#" class="link-2 mx-1">условия использования</a> и <a href="#" class="link-2 mx-1">политику конфиденциальности</a>
                                        </label>
                                    </div>
                                </div>
                                <div class="d-grid">
                                    <button class="btn btn-secondary btn-lg" type="submit">@L["Auth.RegisterButton"] <i class="isax isax-arrow-right-3 ms-1"></i></button>
                                </div>
                            </form>

                            <div class="fs-14 fw-normal d-flex align-items-center justify-content-center">
                                @L["Auth.HaveAccount"]<a href="/account/login" class="link-2 ms-1">@L["Auth.LoginButton"]</a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
