@model dreams.Models.Home.HomePageViewModel
@{
    ViewData["Title"] = "EduPlatform LMS — учитесь онлайн";
    Layout = "_Layout";

    string PriceLabel(decimal p) => p == 0 ? L["Common.Free"].Value : $"{p:N0} кр.";
}

@section Styles {
    <style>
        .hero-edu {
            background: linear-gradient(135deg, #4d44e0 0%, #6b62ff 60%, #8b82ff 100%);
            color: #fff;
            padding: 80px 0 100px;
            position: relative;
            overflow: hidden;
        }
        .hero-edu::before {
            content: ''; position: absolute; right: -100px; top: -100px;
            width: 400px; height: 400px; background: rgba(255,255,255,0.07); border-radius: 50%;
        }
        .hero-edu::after {
            content: ''; position: absolute; left: -150px; bottom: -100px;
            width: 350px; height: 350px; background: rgba(255,255,255,0.05); border-radius: 50%;
        }
        .hero-edu h1 { font-size: 56px; font-weight: 800; line-height: 1.1; }
        .hero-edu .accent { color: #ffd700; }
        .hero-stats { display: flex; gap: 32px; flex-wrap: wrap; margin-top: 32px; }
        .hero-stats .stat .n { font-size: 32px; font-weight: 800; line-height: 1; }
        .hero-stats .stat .l { font-size: 13px; opacity: .9; margin-top: 4px; }
        .cat-pill {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 10px 18px; border-radius: 999px;
            background: rgba(77,68,224,.08); color: #4d44e0;
            font-weight: 600; font-size: 14px; text-decoration: none;
            transition: all .2s;
        }
        .cat-pill:hover { background: #4d44e0; color: #fff; }
        .feature-card {
            background: #fff; border: 1px solid #eef0f7; border-radius: 14px;
            padding: 24px; height: 100%;
        }
        .feature-ico {
            width: 52px; height: 52px; border-radius: 12px;
            background: rgba(77,68,224,.1); color: #4d44e0;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 24px; margin-bottom: 14px;
        }
        .inst-card {
            background: #fff; border: 1px solid #eef0f7; border-radius: 14px;
            padding: 20px; text-align: center; transition: all .2s;
        }
        .inst-card:hover { box-shadow: 0 8px 20px rgba(0,0,0,.06); transform: translateY(-2px); }
        .inst-avatar { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin: 0 auto 12px; }
        .course-card-mini {
            background: #fff; border: 1px solid #eef0f7; border-radius: 14px;
            overflow: hidden; height: 100%; transition: all .2s;
            display: flex; flex-direction: column;
        }
        .course-card-mini:hover { box-shadow: 0 8px 20px rgba(0,0,0,.08); transform: translateY(-2px); }
        .course-card-mini .cover { aspect-ratio: 16/10; object-fit: cover; width: 100%; }
        .course-card-mini .body { padding: 16px; flex: 1; display: flex; flex-direction: column; }
        .cta-banner {
            background: linear-gradient(135deg, #1a1d2e 0%, #2d3252 100%);
            color: #fff; padding: 48px; border-radius: 20px;
            display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
        }
    </style>
}

<section class="hero-edu">
    <div class="container position-relative" style="z-index: 1;">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge bg-white text-secondary mb-3 px-3 py-2">EduPlatform LMS</span>
                <h1 class="mb-3">Учитесь онлайн <span class="accent">у лучших</span> инструкторов</h1>
                <p class="lead opacity-85 mb-4" style="max-width: 600px;">
                    Каталог из десятков курсов: программирование, дизайн, маркетинг, бизнес. Записывайтесь, проходите тесты и получайте сертификаты — всё в одной платформе.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/courses" class="btn btn-light btn-lg fw-semibold">
                        <i class="isax isax-book me-1"></i>Открыть каталог
                    </a>
                    @if (User?.Identity?.IsAuthenticated != true)
                    {
                        <a href="/account/register" class="btn btn-outline-light btn-lg">Зарегистрироваться</a>
                    }
                    else
                    {
                        <a href="/instructor/subscription" class="btn btn-outline-light btn-lg">
                            <i class="isax isax-crown me-1"></i>Стать инструктором
                        </a>
                    }
                </div>
                <div class="hero-stats">
                    <div class="stat"><div class="n">@Model.TotalCourses</div><div class="l">опубликованных курсов</div></div>
                    <div class="stat"><div class="n">@Model.TotalStudents</div><div class="l">студентов</div></div>
                    <div class="stat"><div class="n">@Model.TotalInstructors</div><div class="l">инструкторов</div></div>
                    <div class="stat"><div class="n">@Model.CertificatesIssued</div><div class="l">сертификатов выдано</div></div>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-center">
                <img src="~/assets/img/feature/feature-1.jpg" class="img-fluid rounded-4 shadow-lg" alt="" style="max-width: 90%;">
            </div>
        </div>
    </div>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-4">
                <h3 class="mb-1">Категории курсов</h3>
                <p class="text-muted">Найдите направление, которое вам интересно</p>
            </div>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                @foreach (var c in Model.Categories)
                {
                    <a href="/courses?category=@c.Slug" class="cat-pill">
                        <i class="isax isax-tag"></i>@c.Name
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (Model.FeaturedCourses.Count > 0)
{
    <section class="py-5" style="background: #fafbff;">
        <div class="container">
            <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
                <div>
                    <h3 class="mb-1">Популярные курсы</h3>
                    <p class="text-muted mb-0">Топ по рейтингу и количеству студентов</p>
                </div>
                <a href="/courses" class="btn btn-outline-primary">Все курсы<i class="isax isax-arrow-right-3 ms-1"></i></a>
            </div>
            <div class="row g-3">
                @foreach (var c in Model.FeaturedCourses)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="course-card-mini">
                            <a href="/courses/@c.Slug">
                                <img class="cover" src="@c.CoverUrl" alt="@c.Title">
                            </a>
                            <div class="body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge text-bg-light">@c.Category.Name</span>
                                    <span class="text-warning small">
                                        <i class="fa-solid fa-star"></i> @c.AverageRating.ToString("0.0")
                                    </span>
                                </div>
                                <h6 class="mb-2"><a href="/courses/@c.Slug" class="link-default">@c.Title</a></h6>
                                <div class="text-muted small mb-3">
                                    <a href="/instructors/@c.InstructorId" class="link-secondary">@c.Instructor.FullName</a>
                                    · @c.StudentsCount студентов
                                </div>
                                <div class="mt-auto d-flex justify-content-between align-items-center">
                                    <span class="@(c.Price == 0 ? "text-success" : "text-secondary") fw-bold">@PriceLabel(c.Price)</span>
                                    <a href="/courses/@c.Slug" class="btn btn-sm btn-dark">Подробнее</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h3 class="mb-1">Почему EduPlatform</h3>
            <p class="text-muted">Полный цикл онлайн-обучения: от регистрации до сертификата</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-ico"><i class="isax isax-book"></i></div>
                    <h6>Каталог из БД</h6>
                    <p class="text-muted small mb-0">Фильтры, поиск, сортировка, пагинация. Все курсы — реальные.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-ico"><i class="isax isax-medal"></i></div>
                    <h6>Сертификаты</h6>
                    <p class="text-muted small mb-0">Автовыдача при 100% прогрессе и сданных тестах.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-ico"><i class="isax isax-message"></i></div>
                    <h6>Real-time чат</h6>
                    <p class="text-muted small mb-0">SignalR-чат для каждого курса, история в MongoDB.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="feature-ico"><i class="isax isax-shield-tick"></i></div>
                    <h6>Безопасность</h6>
                    <p class="text-muted small mb-0">Email-подтверждение, 2FA TOTP, CSRF-защита на формах.</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.TopInstructors.Count > 0)
{
    <section class="py-5" style="background: #fafbff;">
        <div class="container">
            <div class="text-center mb-4">
                <h3 class="mb-1">Топ инструкторов</h3>
                <p class="text-muted">Лидеры по количеству студентов</p>
            </div>
            <div class="row g-3 justify-content-center">
                @foreach (var i in Model.TopInstructors)
                {
                    <div class="col-md-4 col-lg-2">
                        <a href="/instructors/@i.Id" class="text-reset text-decoration-none">
                            <div class="inst-card">
                                <img class="inst-avatar" src="@(string.IsNullOrEmpty(i.AvatarUrl) ? "/assets/img/user/user-29.jpg" : i.AvatarUrl)" alt="">
                                <div class="fw-semibold">@i.Name</div>
                                <div class="text-muted small">@i.CoursesCount курсов · @i.StudentsCount студентов</div>
                                @if (i.AverageRating > 0)
                                {
                                    <div class="text-warning small mt-1">
                                        <i class="fa-solid fa-star"></i> @i.AverageRating.ToString("0.0")
                                    </div>
                                }
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="py-5">
    <div class="container">
        <div class="cta-banner">
            <div>
                <h3 class="text-white mb-2">Готовы преподавать?</h3>
                <p class="text-white-50 mb-0" style="max-width: 480px;">Выберите план подписки и начните создавать курсы. Free — без оплаты, до 3 курсов.</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a href="/instructor/subscription" class="btn btn-light fw-semibold">
                    <i class="isax isax-crown me-1"></i>Тарифы подписки
                </a>
                <a href="/about" class="btn btn-outline-light">О платформе</a>
            </div>
        </div>
    </div>
</section>
