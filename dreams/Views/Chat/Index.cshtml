@{
    var course = (EduPlatform.Domain.Entities.Course)ViewData["Course"]!;
    var currentUserId = (string)ViewData["CurrentUserId"]!;
    var currentUserName = (string)ViewData["CurrentUserName"]!;
    var currentAvatar = (string)ViewData["CurrentAvatar"]!;
    var isInstructor = (bool)ViewData["IsInstructor"]!;
    var mongoEnabled = (bool)ViewData["MongoEnabled"]!;
    ViewData["Title"] = L["Chat.Title"].Value + ": " + course.Title;
    Layout = "_InnerLayout";
}

@section Styles {
    <style>
        .chat-wrap { max-width: 900px; margin: 0 auto; }
        .chat-card { background: #fff; border: 1px solid #e6e6f0; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,.04); }
        .chat-head { padding: 16px 20px; border-bottom: 1px solid #eef0f7; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .chat-body { height: 60vh; overflow-y: auto; padding: 20px; background: #fafbff; }
        .chat-foot { padding: 14px 16px; border-top: 1px solid #eef0f7; display: flex; gap: 8px; }
        .msg { display: flex; gap: 10px; margin-bottom: 14px; align-items: flex-start; }
        .msg.mine { flex-direction: row-reverse; }
        .msg .avatar { width: 36px; height: 36px; border-radius: 50%; background: #ddd; flex: 0 0 36px; object-fit: cover; }
        .msg .bubble {
            max-width: 70%; padding: 10px 14px; border-radius: 12px;
            background: #fff; border: 1px solid #eef0f7; word-wrap: break-word; white-space: pre-wrap;
        }
        .msg.mine .bubble { background: #4d44e0; color: #fff; border-color: #4d44e0; }
        .msg .meta { font-size: 11px; opacity: .7; margin-top: 4px; }
        .msg .who { font-weight: 600; font-size: 13px; margin-bottom: 4px; }
        .badge-inst { font-size: 10px; background: #ffeacc; color: #b56b00; padding: 1px 6px; border-radius: 999px; margin-left: 6px; }
        .conn-dot { width: 8px; height: 8px; border-radius: 50%; background: #d33; display: inline-block; margin-right: 6px; vertical-align: middle; }
        .conn-dot.ok { background: #2ea043; }
        .conn-dot.warn { background: #f0a800; }
        #chatInput { resize: none; }
        .empty { text-align: center; color: #9aa1b5; padding: 40px 20px; }
    </style>
}

<div class="breadcrumb-bar text-center">
    <div class="container">
        <h2 class="breadcrumb-title mb-2">@L["Chat.Title"]</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="/courses">@L["Nav.Courses"]</a></li>
                <li class="breadcrumb-item"><a href="/courses/@course.Slug">@course.Title</a></li>
                <li class="breadcrumb-item active">@L["Chat.Title"]</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5">
    <div class="chat-wrap">
        @if (!mongoEnabled)
        {
            <div class="alert alert-warning small mb-3">
                <i class="isax isax-info-circle me-1"></i>@L["Chat.MongoOffWarning"]
            </div>
        }
        <div class="chat-card">
            <div class="chat-head">
                <div>
                    <div class="fw-semibold">@course.Title</div>
                    <div class="text-muted small">
                        <span class="conn-dot warn" id="connDot"></span><span id="connText">@L["Chat.Connecting"]</span>
                    </div>
                </div>
                <a href="/courses/@course.Slug" class="btn btn-sm btn-outline-secondary">
                    <i class="isax isax-arrow-left-2 me-1"></i>@L["Chat.BackToCourse"]
                </a>
            </div>
            <div class="chat-body" id="chatBody">
                <div class="empty" id="emptyHint">@L["Chat.Connecting"]</div>
            </div>
            <form class="chat-foot" id="chatForm" autocomplete="off">
                <textarea id="chatInput" class="form-control" rows="1" maxlength="2000" placeholder="@L["Chat.WritePlaceholder"]"></textarea>
                <button type="submit" class="btn btn-primary" id="sendBtn" disabled>
                    <i class="isax isax-send-2"></i>
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            const COURSE_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(course.Id.ToString()));
            const COURSE_SLUG = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(course.Slug));
            const ME_ID = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUserId));
            const ME_NAME = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentUserName));
            const ME_AVATAR = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(currentAvatar));
            const I_AM_INSTRUCTOR = @(isInstructor ? "true" : "false");
            const T = {
                online: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.Online"].Value)),
                reconnect: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.Reconnecting"].Value)),
                offline: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.Offline"].Value)),
                noAccess: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.NoAccess"].Value)),
                empty: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.Empty"].Value)),
                loadFail: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.LoadFail"].Value)),
                instr: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Chat.InstructorBadge"].Value))
            };

            const body = document.getElementById('chatBody');
            const empty = document.getElementById('emptyHint');
            const form = document.getElementById('chatForm');
            const input = document.getElementById('chatInput');
            const sendBtn = document.getElementById('sendBtn');
            const dot = document.getElementById('connDot');
            const connText = document.getElementById('connText');

            function escapeHtml(s) {
                return String(s).replace(/[&<>"']/g, c => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[c]));
            }

            function fmtTime(iso) {
                try {
                    const d = new Date(iso);
                    return d.toLocaleString([], { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
                } catch { return ''; }
            }

            function avatarFor(url) {
                return url
                    ? `<img class="avatar" src="${escapeHtml(url)}" alt="">`
                    : `<div class="avatar d-inline-flex align-items-center justify-content-center" style="background:#4d44e0;color:#fff;font-weight:600;">·</div>`;
            }

            function addMessage(m) {
                if (empty) empty.remove();
                const mine = String(m.userId).toLowerCase() === String(ME_ID).toLowerCase();
                const wrap = document.createElement('div');
                wrap.className = 'msg' + (mine ? ' mine' : '');
                wrap.innerHTML =
                    avatarFor(m.avatarUrl) +
                    `<div class="bubble">
                        <div class="who">${escapeHtml(m.userName)}${m.isInstructor ? '<span class="badge-inst">' + escapeHtml(T.instr) + '</span>' : ''}</div>
                        <div>${escapeHtml(m.text)}</div>
                        <div class="meta">${fmtTime(m.at)}</div>
                    </div>`;
                body.appendChild(wrap);
                body.scrollTop = body.scrollHeight;
            }

            function setConn(state) {
                dot.classList.remove('ok', 'warn');
                if (state === 'ok') { dot.classList.add('ok'); connText.textContent = T.online; sendBtn.disabled = false; }
                else if (state === 'warn') { dot.classList.add('warn'); connText.textContent = T.reconnect; sendBtn.disabled = true; }
                else { connText.textContent = T.offline; sendBtn.disabled = true; }
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/course-chat')
                .withAutomaticReconnect()
                .build();

            connection.on('ReceiveMessage', addMessage);
            connection.onreconnecting(() => setConn('warn'));
            connection.onreconnected(async () => { setConn('ok'); await connection.invoke('JoinCourse', COURSE_ID); });
            connection.onclose(() => setConn('off'));

            async function loadHistory() {
                try {
                    const r = await fetch(`/courses/${encodeURIComponent(COURSE_SLUG)}/chat/history?limit=100`);
                    if (!r.ok) throw new Error('history ' + r.status);
                    const list = await r.json();
                    if (list.length === 0) {
                        empty.textContent = T.empty;
                    } else {
                        body.innerHTML = '';
                        list.forEach(addMessage);
                    }
                } catch (e) {
                    empty.textContent = T.loadFail;
                }
            }

            (async () => {
                await loadHistory();
                try {
                    await connection.start();
                    const ok = await connection.invoke('JoinCourse', COURSE_ID);
                    if (!ok) { setConn('off'); connText.textContent = T.noAccess; return; }
                    setConn('ok');
                    input.focus();
                } catch (e) {
                    setConn('off');
                    console.error(e);
                }
            })();

            form.addEventListener('submit', async e => {
                e.preventDefault();
                const text = input.value.trim();
                if (!text) return;
                sendBtn.disabled = true;
                try {
                    await connection.invoke('SendMessage', COURSE_ID, text);
                    input.value = '';
                } catch (e) { console.error(e); }
                finally { sendBtn.disabled = false; input.focus(); }
            });

            input.addEventListener('keydown', e => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    form.requestSubmit();
                }
            });
        })();
    </script>
}
